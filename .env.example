# Opinion CLI Configuration
# Copy this file to .env and fill in your values

# Required: Opinion API key (minimum for read-only access)
# Get from: https://docs.opinion.trade/developer-guide/opinion-clob-sdk/getting-started/quick-start#prerequisites
API_KEY=your_api_key_here

# Optional: For trading functionality, set these values:
# If not set, CLI will work in read-only mode

# Blockchain RPC URL (BSC mainnet example)
# RPC_URL=https://bsc-dataseed.binance.org/

# Your private key for transactions (keep secure!)
# PRIVATE_KEY=your_private_key_here

# Multi-signature wallet address
# Get from: Opinion platform "My Profile" section
# MULTI_SIG_ADDRESS=your_multisig_address_here

# Optional: Chain ID (default: 56 for BSC)
CHAIN_ID=56

# Optional: Opinion API host (default: https://proxy.opinion.trade:8443)
OPINION_HOST=https://proxy.opinion.trade:8443

# Optional: Cache settings (default: 0 - no caching for real-time monitoring)
MARKET_CACHE_TTL=0
QUOTE_TOKENS_CACHE_TTL=0
ENABLE_TRADING_CHECK_INTERVAL=0

# Optional: Rate limiting (default: 12 requests per second)
RATE_LIMIT=12